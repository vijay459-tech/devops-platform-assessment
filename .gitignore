__pycache__/
*.pyc
.venv/
.env
.env.*
reports/*
!reports/.gitkeep
# Terraform: never commit state, plans or local var files with real values.
.terraform/
*.tfstate
*.tfstate.*
tfplan
*.tfplan
crash.log
override.tf
override.tf.json
# The lock file MUST be committed (see terraform/README.md).
!.terraform.lock.hcl
